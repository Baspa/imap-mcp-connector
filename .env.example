# Public hostname Caddy serves (DNS must point here)
DOMAIN=mail.example.com
# Must match DOMAIN, https only
PUBLIC_URL=https://mail.example.com
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Who may sign in. Set at least one; when both are set, the email domain AND the IMAP host must match.
# ALLOWED_IMAP_HOSTS=* allows any public server that auto-discovery finds. Servers users type in by hand must be
# listed by name; most company domains (including Google Workspace) need theirs listed, e.g. imap.gmail.com.
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_IMAP_HOSTS=
# Allow mail servers on private networks and unencrypted connections (LAN setups only)
ALLOW_PRIVATE_HOSTS=false
DEFAULT_SEND_LIMIT_PER_HOUR=20
